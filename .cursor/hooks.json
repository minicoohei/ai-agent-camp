{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "python3 .cursor/hooks/bash_guard.py",
        "failClosed": true
      }
    ],
    "afterFileEdit": [
      {
        "command": "python3 .cursor/hooks/write_guard.py",
        "failClosed": true
      }
    ]
  }
}
