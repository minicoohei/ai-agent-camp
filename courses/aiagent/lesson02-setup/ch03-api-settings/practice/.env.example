# ===========================================
# aiagent-base 環境変数テンプレート
# ===========================================
# このファイルを .env にコピーして値を設定してください
# cp .env.example .env
#
# 注意: .env ファイルは絶対にコミットしないでください

# --- 必須 ---

# Google Gemini API キー
# 取得先: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- 推奨 ---

# Anthropic API キー（Claude API）
# 取得先: https://console.anthropic.com
ANTHROPIC_API_KEY=

# --- オプション ---

# OpenAI API キー
# 取得先: https://platform.openai.com
OPENAI_API_KEY=

# fal.ai API キー（動画生成用）
# 取得先: https://fal.ai
FAL_KEY=

# Slack Bot Token（Slack連携用）
# 取得先: https://api.slack.com/apps
SLACK_BOT_TOKEN=

# Slack Webhook URL（通知用）
SLACK_WEBHOOK_URL=

# Notion API キー（Notion連携用）
# 取得先: https://www.notion.so/my-integrations
NOTION_API_KEY=

# GitHub Personal Access Token（GitHub API用）
# 取得先: https://github.com/settings/tokens
GITHUB_TOKEN=
