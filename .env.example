# ===================================================================
# AIAgent Base - 環境変数設定テンプレート
# ===================================================================
# 
# 使い方:
# 1. このファイルを .env としてコピー: cp .env.example .env
# 2. 必要なAPIキーを設定
# 3. .envファイルは絶対にコミットしない（.gitignoreで除外済み）
#
# ===================================================================

# === 必須: Gemini API ===
# Google AI Studio で取得: https://aistudio.google.com/
# 用途: 画像生成、LLM機能、コンテンツ分析
GEMINI_API_KEY=your_gemini_api_key_here

# === オプション: Google OAuth ===
# Google Cloud Console で取得
# 用途: Gmail、Calendar、Drive 連携
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# === オプション: Slack ===
# Slack App 管理画面で取得
# 用途: Slack検索、メッセージ取得、TODO抽出
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_USER_TOKEN=xoxp-your-user-token
SLACK_WORKSPACE_ID=your-workspace-id

# === オプション: BigQuery ===
# Google Cloud Console で設定
# 用途: データ分析、クエリ実行
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_APPLICATION_CREDENTIALS=path/to/credentials.json

# === オプション: Notion ===
# Notion の標準セットアップは OAuth 統一です（環境変数は不要）。
# セットアップは `/setup-notion` を実行してください:
#   - ncli login（ブラウザ OAuth）
#   - Notion 公式 Hosted MCP（https://mcp.notion.com/mcp）
#
# ⚠️ 一部の旧スクリプト（tools/run_lesson_14_11.py 等）はまだ
#    Internal Integration Token を直接読みます。該当レッスンを
#    実行する場合のみ以下を設定してください（将来 OAuth 化予定）:
# NOTION_API_KEY=secret_your_notion_api_key

# === オプション: GitHub ===
# GitHub Settings → Developer settings → Personal access tokens
# 用途: GitHub Actions、リポジトリ操作
GITHUB_TOKEN=ghp_your_github_token

# === オプション: FAL.ai ===
# FAL.ai で取得: https://fal.ai
# 用途: AI動画生成、画像生成
FAL_KEY=your_fal_key_here

# === オプション: Kling AI ===
# Kling AI で取得
# 用途: AI動画生成
KLING_ACCESS_KEY=
KLING_SECRET_KEY=

# === オプション: HeyGen ===
# HeyGen で取得
# 用途: アバター動画生成
HEYGEN_API_KEY=

# === オプション: Google Veo ===
# Google AI Studio で取得
# 用途: AI動画生成（Veo 3）
VEO_API_KEY=

# === オプション: X (Twitter) API ===
# X Developer Portal で取得: https://developer.x.com/en/portal/dashboard
# 用途: X検索、ツイート分析
X_BEARER_TOKEN=your_x_bearer_token_here

# === オプション: Typefully API ===
# Typefully Settings → API で取得: https://typefully.com/settings/api
# 用途: 投稿ドラフト作成、A/Bテスト、コンテンツ最適化
TYPEFULLY_API_KEY=

# === オプション: その他 ===
# プロジェクト固有の設定
OUTPUT_DIR=./output
TEMP_DIR=./temp
LOG_LEVEL=INFO

# === ローカル開発設定 ===
# 開発環境用の設定
DEBUG=false
DEVELOPMENT_MODE=false
